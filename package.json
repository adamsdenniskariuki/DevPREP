{
  "name": "devprep",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "npm run content",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run content",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretypecheck": "npm run content",
    "typecheck": "tsc -b",
    "pretest": "npm run content",
    "test": "vitest run",
    "pretest:e2e": "npm run content",
    "test:e2e": "playwright test",
    "pretest:pwa": "npm run content",
    "test:pwa": "playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electric-sql/pglite": "0.5.8",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@lezer/highlight": "^1.2.5",
    "pyodide": "314.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
