{
  "id": "cooldown-schedule-length",
  "title": "Shortest schedule with cooldowns",
  "pattern": "Greedy",
  "level": "sse",
  "difficulty": "stretch",
  "paths": [
    "senior"
  ],
  "prompt": "A machine runs one job per time unit, and two jobs with the same label need at least gap time units between them; return the fewest time units to run every job.\n\n- jobs has 0 to 100,000 labels, each an uppercase letter from \"A\" to \"Z\"; 0 <= gap <= 100.\n- Jobs may run in any order. In any time unit the machine either runs one job or sits idle.\n- If a label runs at time t, the same label cannot run again before time t + gap + 1.\n- Return the total number of time units, counting idle units in between jobs.",
  "function": {
    "js": "scheduleLength",
    "py": "schedule_length"
  },
  "starter": {
    "js": "function scheduleLength(jobs, gap) {\n  // Your code here\n}\n",
    "py": "def schedule_length(jobs, gap):\n    # Your code here\n    pass\n"
  },
