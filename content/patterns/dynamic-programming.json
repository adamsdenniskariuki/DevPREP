  "visualiser": {
    "tracer": "house-rob",
    "function": {
      "js": "rob",
      "py": "rob"
    },
    "code": {
      "js": "function rob(houses) {\n  const n = houses.length, dp = Array(n + 1).fill(0) //@init\n  dp[1] = houses[0] //@base\n  for (let i = 2; i <= n; i++) {\n    dp[i] = Math.max(dp[i - 1], dp[i - 2] + houses[i - 1]) //@fill\n  }\n  return dp[n] //@done\n}",
      "py": "def rob(houses):\n    n = len(houses); dp = [0] * (n + 1)  #@init\n    dp[1] = houses[0]  #@base\n    for i in range(2, n + 1):\n        dp[i] = max(dp[i - 1], dp[i - 2] + houses[i - 1])  #@fill\n    return dp[n]  #@done"
    },
