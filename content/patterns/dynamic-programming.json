{
  "id": "dynamic-programming",
  "title": "Dynamic programming",
  "category": "Dynamic programming",
  "level": "se",
  "summary": "Dynamic programming solves a problem from the answers to smaller versions of itself. Each smaller answer is computed once and stored in a table, so overlapping work is never repeated.",
  "minutes": 15,
  "idea": "Name the state (dp[i] means …), write how it is built from smaller states, set the base cases, then fill the table in an order where every input is ready.",
  "recognise": {
    "signals": [
      {
        "see": "The question asks for the number of ways, the minimum cost, the maximum value, or whether something is possible.",
        "think": "Counting and optimising over many choices is the core DP signal. Try writing the answer for n from answers for smaller n."
      },
      {
        "see": "A brute-force recursion calls itself with the same arguments again and again.",
        "think": "Overlapping subproblems: store each result (memoise) or fill a table bottom-up so each state is solved once."
      },
      {
        "see": "Each step makes a choice (take or skip, which move to make) and the best overall answer uses best answers to the parts.",
        "think": "Optimal substructure: the recurrence is a max, min or sum over those choices."
      }
    ],
    "phrasings": [
      "A thief cannot rob two neighbouring houses. What is the most they can take?",
      "How many ways can you climb n stairs taking 1 or 2 steps at a time?",
      "Find the fewest coins that add up to an amount."
    ]
  },
