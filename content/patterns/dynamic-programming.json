  "template": {
    "py": "def solve(items):\n    n = len(items)\n    dp = [0] * (n + 1)  # dp[i] = answer for the first i items\n    dp[0] = 0  # base case: nothing to choose from\n    for i in range(1, n + 1):\n        skip = dp[i - 1]\n        take = items[i - 1] + (dp[i - 2] if i >= 2 else 0)\n        dp[i] = max(skip, take)  # combine the choices\n    return dp[n]\n",
    "js": "function solve(items) {\n  const n = items.length\n  const dp = Array(n + 1).fill(0) // dp[i] = answer for the first i items\n  dp[0] = 0 // base case: nothing to choose from\n  for (let i = 1; i <= n; i++) {\n    const skip = dp[i - 1]\n    const take = items[i - 1] + (i >= 2 ? dp[i - 2] : 0)\n    dp[i] = Math.max(skip, take) // combine the choices\n  }\n  return dp[n]\n}\n",
    "ts": "function solve(items: number[]): number {\n  const n = items.length\n  const dp: number[] = Array(n + 1).fill(0) // dp[i] = answer for the first i items\n  dp[0] = 0 // base case: nothing to choose from\n  for (let i = 1; i <= n; i++) {\n    const skip = dp[i - 1]\n    const take = items[i - 1] + (i >= 2 ? dp[i - 2] : 0)\n    dp[i] = Math.max(skip, take) // combine the choices\n  }\n  return dp[n]\n}\n"
  },
  "oneLiner": "dp[i] = best(choice over dp[smaller]); fill from the base cases up; return dp[n]",
  "exercise": {
    "prompt": "Each stair has a cost. You start on stair 0 or stair 1 for free. Paying cost[i] lets you climb one or two stairs from stair i. Return the least total cost to get past the last stair. The starter returns the cost to reach the last stair instead of the top above it.",
    "function": {
      "js": "minCostClimb",
      "py": "min_cost_climb"
    },
    "starter": {
      "js": "function minCostClimb(cost) {\n  const n = cost.length\n  const dp = Array(n + 1).fill(0)\n  for (let i = 2; i <= n; i++) {\n    dp[i] = Math.min(dp[i - 1] + cost[i - 1], dp[i - 2] + cost[i - 2])\n  }\n  return dp[n - 1]\n}\n",
      "py": "def min_cost_climb(cost):\n    n = len(cost)\n    dp = [0] * (n + 1)\n    for i in range(2, n + 1):\n        dp[i] = min(dp[i - 1] + cost[i - 1], dp[i - 2] + cost[i - 2])\n    return dp[n - 1]\n",
      "ts": "function minCostClimb(cost: number[]): number {\n  const n = cost.length\n  const dp: number[] = Array(n + 1).fill(0)\n  for (let i = 2; i <= n; i++) {\n    dp[i] = Math.min(dp[i - 1] + cost[i - 1], dp[i - 2] + cost[i - 2])\n  }\n  return dp[n - 1]\n}\n"
    },
    "solution": {
      "js": "function minCostClimb(cost) {\n  const n = cost.length\n  const dp = Array(n + 1).fill(0)\n  for (let i = 2; i <= n; i++) {\n    dp[i] = Math.min(dp[i - 1] + cost[i - 1], dp[i - 2] + cost[i - 2])\n  }\n  return dp[n]\n}\n",
      "py": "def min_cost_climb(cost):\n    n = len(cost)\n    dp = [0] * (n + 1)\n    for i in range(2, n + 1):\n        dp[i] = min(dp[i - 1] + cost[i - 1], dp[i - 2] + cost[i - 2])\n    return dp[n]\n",
      "ts": "function minCostClimb(cost: number[]): number {\n  const n = cost.length\n  const dp: number[] = Array(n + 1).fill(0)\n  for (let i = 2; i <= n; i++) {\n    dp[i] = Math.min(dp[i - 1] + cost[i - 1], dp[i - 2] + cost[i - 2])\n  }\n  return dp[n]\n}\n"
