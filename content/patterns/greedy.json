  "template": {
    "py": "def solve(items):\n    items = sorted(items, key=lambda item: item[1])  # order by the greedy key\n    count, last = 0, float(\"-inf\")\n    for start, end in items:\n        if start >= last:  # the choice rule: take it if it fits\n            count += 1\n            last = end  # commit; never undone\n    return count\n",
    "js": "function solve(items) {\n  const sorted = [...items].sort((a, b) => a[1] - b[1]) // order by the greedy key\n  let count = 0\n  let last = -Infinity\n  for (const [start, end] of sorted) {\n    if (start >= last) { // the choice rule: take it if it fits\n      count++\n      last = end // commit; never undone\n    }\n  }\n  return count\n}\n",
    "ts": "function solve(items: [number, number][]): number {\n  const sorted = [...items].sort((a, b) => a[1] - b[1]) // order by the greedy key\n  let count = 0\n  let last = -Infinity\n  for (const [start, end] of sorted) {\n    if (start >= last) { // the choice rule: take it if it fits\n      count++\n      last = end // commit; never undone\n    }\n  }\n  return count\n}\n"
  },
  "oneLiner": "sort by the key; scan once; take each item the rule allows; prove it with an exchange argument",
  "exercise": {
    "prompt": "Each boat carries at most two people and at most limit kilograms. No person weighs more than limit. Return the fewest boats needed. Greedy rule: the heaviest person left shares with the lightest person left if they fit, otherwise goes alone. The starter forgets to sort.",
    "function": {
      "js": "fewestBoats",
      "py": "fewest_boats"
    },
    "starter": {
      "js": "function fewestBoats(weights, limit) {\n  const w = [...weights]\n  let i = 0\n  let j = w.length - 1\n  let boats = 0\n  while (i <= j) {\n    if (w[i] + w[j] <= limit) i++\n    j--\n    boats++\n  }\n  return boats\n}\n",
      "py": "def fewest_boats(weights, limit):\n    w = list(weights)\n    i, j = 0, len(w) - 1\n    boats = 0\n    while i <= j:\n        if w[i] + w[j] <= limit:\n            i += 1\n        j -= 1\n        boats += 1\n    return boats\n",
      "ts": "function fewestBoats(weights: number[], limit: number): number {\n  const w = [...weights]\n  let i = 0\n  let j = w.length - 1\n  let boats = 0\n  while (i <= j) {\n    if (w[i] + w[j] <= limit) i++\n    j--\n    boats++\n  }\n  return boats\n}\n"
    },
    "solution": {
      "js": "function fewestBoats(weights, limit) {\n  const w = [...weights].sort((a, b) => a - b)\n  let i = 0\n  let j = w.length - 1\n  let boats = 0\n  while (i <= j) {\n    if (w[i] + w[j] <= limit) i++\n    j--\n    boats++\n  }\n  return boats\n}\n",
      "py": "def fewest_boats(weights, limit):\n    w = sorted(weights)\n    i, j = 0, len(w) - 1\n    boats = 0\n    while i <= j:\n        if w[i] + w[j] <= limit:\n            i += 1\n        j -= 1\n        boats += 1\n    return boats\n",
      "ts": "function fewestBoats(weights: number[], limit: number): number {\n  const w = [...weights].sort((a, b) => a - b)\n  let i = 0\n  let j = w.length - 1\n  let boats = 0\n  while (i <= j) {\n    if (w[i] + w[j] <= limit) i++\n    j--\n    boats++\n  }\n  return boats\n}\n"
    },
