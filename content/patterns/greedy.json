  "visualiser": {
    "tracer": "jump-reach",
    "function": {
      "js": "fewestJumps",
      "py": "fewest_jumps"
    },
    "code": {
      "js": "function fewestJumps(nums) {\n  const n = nums.length; let jumps = 0, end = 0, far = 0 //@init\n  for (let i = 0; i < n - 1; i++) {\n    far = Math.max(far, i + nums[i]) //@reach\n    if (i === end) {\n      if (far === i) return -1 //@stuck\n      jumps++; end = far //@jump\n    }\n  }\n  return jumps //@done\n}",
      "py": "def fewest_jumps(nums):\n    n = len(nums); jumps = end = far = 0  #@init\n    for i in range(n - 1):\n        far = max(far, i + nums[i])  #@reach\n        if i == end:\n            if far == i: return -1  #@stuck\n            jumps += 1; end = far  #@jump\n    return jumps  #@done"
    },
