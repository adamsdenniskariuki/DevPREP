{
  "id": "top-k",
  "parent": "heaps",
  "title": "Top K",
  "category": "Heaps",
  "level": "se",
  "summary": "To keep the k largest items, hold a min-heap of size k. Its root is the weakest of the current top k, so each new item only has to beat the root.",
  "minutes": 12,
  "idea": "The smallest of the top k sits at the root. A new value replaces it only if it is bigger, so the heap never grows past k.",
  "recognise": {
    "signals": [
      {
        "see": "The question asks for the k largest, k smallest, k closest or k most frequent items.",
        "think": "Keep a heap of size k. For the k largest use a min-heap, so the item to evict is at the root."
      },
      {
        "see": "The k-th largest value is needed as values stream in.",
        "think": "Keep a min-heap of size k. After each value, the root is the k-th largest so far."
      },
      {
        "see": "n is huge but k is small, and sorting everything would be wasteful.",
        "think": "A size-k heap costs O(n log k) time and O(k) space, instead of O(n log n) to sort."
      }
    ],
    "phrasings": [
      "A leaderboard must always show the 10 highest scores while new scores keep arriving.",
