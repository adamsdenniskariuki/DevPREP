    "code": {
      "js": "function topK(nums, k) {\n  const heap = [] //@init\n  for (const x of nums) {\n    if (heap.length < k) { //@check\n      push(heap, x) //@push\n    } else if (x > heap[0]) { //@compare\n      heap[0] = x; down(heap, 0) //@replace\n    }\n  }\n  return [...heap].sort((a, b) => b - a) //@done\n}\n\nfunction push(h, x) {\n  h.push(x)\n  let i = h.length - 1\n  while (i > 0 && h[(i - 1) >> 1] > h[i]) {\n    const p = (i - 1) >> 1\n    ;[h[i], h[p]] = [h[p], h[i]]\n    i = p\n  }\n}\n\nfunction down(h, i) {\n  for (;;) {\n    let s = i\n    for (const c of [2 * i + 1, 2 * i + 2]) if (c < h.length && h[c] < h[s]) s = c\n    if (s === i) return\n    ;[h[i], h[s]] = [h[s], h[i]]\n    i = s\n  }\n}",
      "py": "import heapq\n\ndef top_k(nums, k):\n    heap = []  #@init\n    for x in nums:\n        if len(heap) < k:  #@check\n            heapq.heappush(heap, x)  #@push\n        elif x > heap[0]:  #@compare\n            heapq.heapreplace(heap, x)  #@replace\n    return sorted(heap, reverse=True)  #@done"
    },
