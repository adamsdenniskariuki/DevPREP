  "template": {
    "py": "import heapq\n\ndef solve(items, k):\n    heap = []  # min-heap of the k best so far\n    for x in items:\n        if len(heap) < k:\n            heapq.heappush(heap, x)\n        elif x > heap[0]:  # beats the weakest kept item\n            heapq.heapreplace(heap, x)  # pop the root and push x in one step\n    return heap  # heap[0] is the k-th largest\n# Shortcut: heapq.nlargest(k, items) does the same.\n",
    "js": "function solve(items, k) {\n  const heap = [] // min-heap of the k best so far\n  for (const x of items) {\n    if (heap.length < k) push(heap, x)\n    else if (x > heap[0]) { // beats the weakest kept item\n      heap[0] = x\n      down(heap, 0)\n    }\n  }\n  return heap // heap[0] is the k-th largest\n}\n\nfunction push(h, x) {\n  h.push(x)\n  let i = h.length - 1\n  while (i > 0 && h[(i - 1) >> 1] > h[i]) {\n    const p = (i - 1) >> 1\n    ;[h[i], h[p]] = [h[p], h[i]]\n    i = p\n  }\n}\n\nfunction down(h, i) {\n  for (;;) {\n    let s = i\n    for (const c of [2 * i + 1, 2 * i + 2]) if (c < h.length && h[c] < h[s]) s = c\n    if (s === i) return\n    ;[h[i], h[s]] = [h[s], h[i]]\n    i = s\n  }\n}\n",
    "ts": "function solve(items: number[], k: number): number[] {\n  const heap: number[] = [] // min-heap of the k best so far\n  for (const x of items) {\n    if (heap.length < k) push(heap, x)\n    else if (x > heap[0]) { // beats the weakest kept item\n      heap[0] = x\n      down(heap, 0)\n    }\n  }\n  return heap // heap[0] is the k-th largest\n}\n\nfunction push(h: number[], x: number): void {\n  h.push(x)\n  let i = h.length - 1\n  while (i > 0 && h[(i - 1) >> 1] > h[i]) {\n    const p = (i - 1) >> 1\n    ;[h[i], h[p]] = [h[p], h[i]]\n    i = p\n  }\n}\n\nfunction down(h: number[], i: number): void {\n  for (;;) {\n    let s = i\n    for (const c of [2 * i + 1, 2 * i + 2]) if (c < h.length && h[c] < h[s]) s = c\n    if (s === i) return\n    ;[h[i], h[s]] = [h[s], h[i]]\n    i = s\n  }\n}\n"
  },
